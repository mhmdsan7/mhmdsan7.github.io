---
layout: null
permalink: /search.json
sitemap: false
---
[
{%- for post in site.posts -%}
{%- include post-category.html post=post -%}
{%- assign search_summary = post.description | default: post.excerpt | strip_html | normalize_whitespace | replace: "&lt;", "<" | replace: "&gt;", ">" | replace: "&quot;", '"' | replace: "&#39;", "'" | replace: "&amp;", "&" -%}
{%- assign search_text = post.content | strip_html | normalize_whitespace | replace: "&lt;", "<" | replace: "&gt;", ">" | replace: "&quot;", '"' | replace: "&#39;", "'" | replace: "&amp;", "&" %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
    "dateLabel": {{ post.date | date: "%-d %b %Y" | jsonify }},
    "category": {{ post_cat.title | default: "" | jsonify }},
    "tags": {{ post.tags | jsonify }},
    "summary": {{ search_summary | jsonify }},
    "content": {{ search_text | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor %}
]
